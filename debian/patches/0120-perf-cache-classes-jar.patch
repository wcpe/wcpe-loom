+			"loom-cache-output"
+		]
+		ZipUtils.unpackNullable(workJob.existingClasses(), "net/fabricmc/Example.class") == newClass("net/fabricmc/Example")
+
+		2 * cache.getEntry(ExampleHash) >> ExampleCachedData
+		4 * cache.getEntry(_) >> null
+
+		0 * _ // Strict mock
