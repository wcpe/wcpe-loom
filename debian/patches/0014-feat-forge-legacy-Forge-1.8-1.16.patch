+				dataOut.writeUTF(dataIn.readUTF().replace('.', '/')); // obf class name
+				dataOut.writeUTF(dataIn.readUTF().replace('.', '/')); // srg class name
+				in.transferTo(out); // remainder is unchanged
+
+				out.closeEntry();
+			}
+		}
