+		try (JarMerger jarMerger = new JarMerger(minecraftClientPatchedJar.toFile(), minecraftServerPatchedJar.toFile(), minecraftMergedPatchedJar.toFile())) {
+			jarMerger.enableSyntheticParamsOffset();
+			jarMerger.merge();
+		}
