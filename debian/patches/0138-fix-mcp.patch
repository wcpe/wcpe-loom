diff --git a/src/main/java/dev/architectury/loom/mcpconfig/steplogic/DownloadManifestFileLogic.java b/src/main/java/dev/architectury/loom/mcpconfig/steplogic/DownloadManifestFileLogic.java
index 798bb8d3e18a89a08753d57e2f9c5b485371688d..b5f951c027bb7e3bf472b4be6ab86d4fd72311a2 100644
