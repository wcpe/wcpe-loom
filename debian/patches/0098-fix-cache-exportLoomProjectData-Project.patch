MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

该任务的 @TaskAction 直接调用 LoomProjectData.fromProject(getProject())，
开启配置缓存后必然失败：

  InvalidUserCodeException: Invocation of 'Task.project' by task
  ':lib:exportLoomProjectData' at execution time is unsupported with
  the configuration cache.

问题一直没被发现，是因为该任务只在多项目构建解析 loomProjectDataElements
时才被调度，而既有的配置缓存用例都是单项目，覆盖不到它。

改法：把整个 LoomProjectData 在配置期算好，作为唯一 @Input 登记，执行期
只做写文件。顺带修掉一个缓存正确性问题——原先只把 mod 的 JSON 字符串登记
为输入，而 DTO 里每个 mod 还带着 resources（mixin 配置、AT/AW、javadoc、
原始元数据文件的字节内容），依赖方靠它重建模组视图。这些字节变化不会让旧
任务失效，构建缓存可能还原出「JSON 新、资源旧」的错配数据。直接登记
Serializable 的 DTO 让缓存键覆盖全部内容，项目身份本来也在 DTO 里，因此
不再需要单独的 projectPath 输入。

新增 ExportLoomProjectDataTest：显式请求该任务，并用
--configuration-cache-problems=fail 把配置缓存问题升级成失败（否则只是
警告，用例会静默通过）。已实测还原旧代码时两个场景均按上述异常失败。

Origin: vendor, wcpe-loom
Forwarded: no

diff --git a/src/main/java/net/fabricmc/loom/task/ExportLoomProjectDataTask.java b/src/main/java/net/fabricmc/loom/task/ExportLoomProjectDataTask.java
index ff5eb13ebf3e6e4005cf8433f0c274c2834028bb..ebaa922f81f1b1a6f394a60ad4630fc272788f20 100644
--- a/src/main/java/net/fabricmc/loom/task/ExportLoomProjectDataTask.java
+++ b/src/main/java/net/fabricmc/loom/task/ExportLoomProjectDataTask.java
@@ -28,15 +28,12 @@ import java.io.IOException;
 
 import org.gradle.api.DefaultTask;
 import org.gradle.api.file.RegularFileProperty;
-import org.gradle.api.provider.ListProperty;
 import org.gradle.api.provider.Property;
 import org.gradle.api.tasks.CacheableTask;
 import org.gradle.api.tasks.Input;
-import org.gradle.api.tasks.Optional;
 import org.gradle.api.tasks.OutputFile;
 import org.gradle.api.tasks.TaskAction;
 
-import net.fabricmc.loom.LoomGradleExtension;
 import net.fabricmc.loom.internal.LoomProjectData;
 
 /**
@@ -44,81 +41,50 @@ import net.fabricmc.loom.internal.LoomProjectData;
  *
  * <p>输出通过 {@code loomProjectDataElements} 可消费配置暴露：消费方可以解析该配置（触发本任务），
  * 也可以直接读文件，所以它必须随项目身份与内容一起失效。本类保留 {@link CacheableTask}，
- * 同时把 {@link LoomProjectData#fromProject(org.gradle.api.Project)} 真正依赖的内容逐项声明为输入，
- * 原因有两点：
+ * 并把 {@link LoomProjectData#fromProject(org.gradle.api.Project)} 的**完整结果**登记为唯一输入，
+ * 原因有三点：
  *
  * <ul>
  *     <li>不声明输入时，Gradle 只按「输出是否存在」判定 UP-TO-DATE：改了 mod 元数据或映射标识之后文件不刷新，
  *         日常被内存共享表掩盖，只在回退路径与外部消费方那里暴露成过期数据；
  *     <li>构建缓存键里没有项目身份时，多个项目（甚至不同项目路径的工作副本）会算出同一个键，
- *         共享缓存可能把别的项目的 {@code project-data.json} 还原到本项目。
+ *         共享缓存可能把别的项目的 {@code project-data.json} 还原到本项目；
+ *     <li>DTO 里的每个 mod 还带着 {@code resources}（mixin 配置、AT/AW、javadoc、原始元数据文件的**字节内容**），
+ *         依赖方靠它重建模组视图。早期只把 JSON 字符串登记成输入，这些字节变化不会让本任务失效，
+ *         构建缓存可能还原出「JSON 是新的、资源是旧的」的错配数据。
  * </ul>
  *
- * <p>所有输入都用 {@link org.gradle.api.provider.Provider} 惰性求值：配置期只登记「怎么取」，
- * 读取映射配置、mod 元数据与 Mixin AP 输出都发生在执行期，不会在配置阶段强制求值。
+ * <p><b>执行期不得访问 {@link org.gradle.api.Project}</b>：整个 DTO 在配置期由
+ * {@link #getProjectData()} 的 convention 求值并序列化，{@link #exportProjectData()} 只做写文件。
+ * 早期的实现在 {@code @TaskAction} 里调用 {@code fromProject(getProject())}，开启配置缓存后
+ * 会抛 {@code InvalidUserCodeException}——本任务曾因此完全无法在配置缓存下运行。
  */
 @CacheableTask
 public abstract class ExportLoomProjectDataTask extends DefaultTask {
 	public ExportLoomProjectDataTask() {
 		getOutputFile().convention(getProject().getLayout().getBuildDirectory().file("loom/project-data.json"));
 
-		getProjectPath().convention(getProject().getPath());
-		getMappingId().convention(getProject().provider(() -> LoomProjectData.readMappingId(getProject())));
-		getProductionNamespace().convention(getProject().provider(() -> LoomProjectData.readProductionNamespace(getProject())));
-		getSplitEnvironmentSourceSets().convention(getProject().provider(() -> LoomGradleExtension.get(getProject()).areEnvironmentSourceSetsSplit()));
-		getModJson().convention(getProject().provider(() -> LoomProjectData.readModJson(getProject())));
-		getMixinMappingFiles().convention(getProject().provider(() -> LoomProjectData.readMixinMappingFiles(getProject())));
+		// 在配置期把 DTO 完整算出来：Provider 的求值发生在配置阶段收尾，
+		// 此时读映射配置、mod 元数据与 Mixin AP 输出都是合法的；执行期只剩反序列化与写盘。
+		getProjectData().convention(getProject().provider(() -> LoomProjectData.fromProject(getProject())));
 	}
 
 	/**
-	 * 项目路径，作为数据身份参与缓存键，避免共享缓存在不同项目之间复用同一份数据.
-	 */
-	@Input
-	public abstract Property<String> getProjectPath();
-
-	/**
-	 * 映射标识，与 {@link LoomProjectData#fromProject(org.gradle.api.Project)} 写入 DTO 的值同源.
-	 *
-	 * <p>映射尚未就绪或未启用混淆时该属性为空（用 {@code @Optional} 表达，而不是伪造一个占位值）。
-	 */
-	@Input
-	@Optional
-	public abstract Property<String> getMappingId();
-
-	/**
-	 * 生产命名空间，与 DTO 里写入的值同源；未配置时为空.
-	 */
-	@Input
-	@Optional
-	public abstract Property<String> getProductionNamespace();
-
-	/**
-	 * 是否拆分环境源集，与 DTO 里写入的值同源.
-	 */
-	@Input
-	public abstract Property<Boolean> getSplitEnvironmentSourceSets();
-
-	/**
-	 * 项目内全部 mod 的元数据 JSON，与 DTO 中的 mod 列表一一对应.
-	 */
-	@Input
-	public abstract ListProperty<String> getModJson();
-
-	/**
-	 * Mixin AP 映射文件的路径列表.
+	 * 要导出的跨项目数据，作为唯一输入参与指纹与构建缓存键.
 	 *
-	 * <p>只登记路径而不是文件内容：DTO 里保存的也是路径，依赖方直接按路径读取生产者项目的文件，
-	 * 文件内容不属于导出内容。反过来，把它们声明成 {@code @InputFiles} 会让本任务输入命中
-	 * {@code compileJava} 的输出，从而引入未声明的隐式任务依赖（Gradle 会因此禁用执行优化）。
+	 * <p>直接登记 {@link LoomProjectData}（而非拆成若干字符串）：它实现了 {@link java.io.Serializable}，
+	 * 既能让配置缓存正确存取，也能让缓存键覆盖 mod 资源字节，避免「JSON 新、资源旧」的错配。
+	 * 项目身份（{@code projectPath}）本来就在 DTO 里，因此不必再单独声明输入。
 	 */
 	@Input
-	public abstract ListProperty<String> getMixinMappingFiles();
+	public abstract Property<LoomProjectData> getProjectData();
 
 	@OutputFile
 	public abstract RegularFileProperty getOutputFile();
 
 	@TaskAction
 	public void exportProjectData() throws IOException {
-		LoomProjectData.fromProject(getProject()).write(getOutputFile().get().getAsFile().toPath());
+		// 只读输入属性：执行期访问 Project 会被 Gradle 直接拒绝（配置缓存下抛 InvalidUserCodeException）。
+		getProjectData().get().write(getOutputFile().get().getAsFile().toPath());
 	}
 }
diff --git a/src/test/groovy/net/fabricmc/loom/test/integration/ExportLoomProjectDataTest.groovy b/src/test/groovy/net/fabricmc/loom/test/integration/ExportLoomProjectDataTest.groovy
