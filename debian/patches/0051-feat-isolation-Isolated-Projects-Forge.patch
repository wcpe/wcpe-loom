diff --git a/src/test/resources/projects/forge/multiProjectIsolated/gradle.properties b/src/test/resources/projects/forge/multiProjectIsolated/gradle.properties
new file mode 100644
index 0000000000000000000000000000000000000000..14e1a3b03ccc7f972bca522ea9129424de0ed5fa
--- /dev/null
+++ b/src/test/resources/projects/forge/multiProjectIsolated/gradle.properties
@@ -0,0 +1,10 @@
+# 该夹具用于验证 Forge 多子项目在隔离项目模式下的行为：
+# common 子项目产出 LoomProjectData，mod 子项目通过项目依赖跨项目读取它。
+org.gradle.jvmargs=-Xmx1G
+
+# Mod Properties
+mod_version=1.0.0
+maven_group=com.example
+
+# 平台必须是 Forge，否则 Loom 会走 Fabric 流程
+loom.platform=forge
diff --git a/src/test/resources/projects/forge/multiProjectIsolated/mod/build.gradle b/src/test/resources/projects/forge/multiProjectIsolated/mod/build.gradle
new file mode 100644
index 0000000000000000000000000000000000000000..ebb3617e1431f56b08face218a7303d77ea2f1a4
--- /dev/null
+++ b/src/test/resources/projects/forge/multiProjectIsolated/mod/build.gradle
@@ -0,0 +1,31 @@
+plugins {
+	id 'dev.architectury.loom'
+}
+
+java {
+	sourceCompatibility = JavaVersion.VERSION_17
+	targetCompatibility = JavaVersion.VERSION_17
+}
+
+tasks.withType(JavaCompile).configureEach {
+	it.options.release = 17
+}
+
+base {
+	archivesName = "mod"
+}
+
+version = project.mod_version
+group = project.maven_group
+
+dependencies {
+	minecraft "com.mojang:minecraft:@MCVERSION@"
+	mappings loom.officialMojangMappings()
+	forge "net.minecraftforge:forge:@MCVERSION@-@FORGEVERSION@"
+
+	// 关键点：依赖另一个 Loom 子项目。
+	// 在隔离项目模式下，对这个依赖的 Loom 元数据读取必须通过可序列化的
+	// LoomProjectData DTO（loomProjectDataElements 配置 + exportLoomProjectData 任务），
+	// 而不能直接访问 common 子项目的 Project / LoomGradleExtension。
+	modImplementation project(":common")
+}
