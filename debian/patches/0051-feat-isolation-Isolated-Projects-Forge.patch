@@ -0,0 +1,2 @@
+// 根项目只作为多项目容器，不应用 Loom，
+// 这样 mod 子项目读取 common 子项目的 Loom 数据只能走跨项目路径。
diff --git a/src/test/resources/projects/forge/multiProjectIsolated/common/build.gradle b/src/test/resources/projects/forge/multiProjectIsolated/common/build.gradle
