index 45b2df95d5e2808c800f978e4fc32bb82c4f31d4..faac20950e49348d240d3ece17f984a9ee6270cf 100644
--- a/src/main/java/net/fabricmc/loom/configuration/CompileConfiguration.java
+++ b/src/main/java/net/fabricmc/loom/configuration/CompileConfiguration.java
@@ -334,25 +334,12 @@ public abstract class CompileConfiguration implements Runnable {
 		final String key = "minecraft-provision:" + extension.getMinecraftProvider().minecraftVersion() + ":" + mappingsIdentifier;
 		final LoomCacheService cacheService = LoomCacheService.get(project).get();
 
-		// 无锁快路径：所有 mapped provider 的产物均已就绪（shouldRefreshOutputs 为纯只读的
-		// 存在性/脏标志检查）时，本次供给不含任何共享缓存写入，内部 provide 各自的快路径
-		// 也不会取锁，故整段事务可无锁执行。
+		// 可任务化的 provider 只接线，不提前观察其 jar/POM/backup；共享产物由任务检查和生产。
+		// 仍需配置期生产的形态沿用双检事务锁，保持跨进程供给的互斥边界。
 		final var warmContext = new AbstractMappedMinecraftProvider.ProvideContext(true, extension.refreshDeps(), configContext);
 
-		// 用双检锁形式供给 mapped jar：
-		//
-		// 干净环境（CI 首次构建）下，多个共享同一份 Minecraft 的项目会算出同一个 key；
-		// 而 isMappedJarsWarm 在冷构建时全部为 false。若直接进 runExclusive，第 2..N 个项目
-		// 必须先拿到锁才能做那次检查，于是就各自白等「第一个项目做完整条 download→remap」
-		// 的时间（实测在 CI runner 上远超锁超时）。
-		//
-		// runExclusiveChecking 把就绪检查提到取锁之前，并在锁内重检：第一个项目持锁生产，
-		// 其余项目只需等它做完，拿到锁后立刻发现产物已就绪而秒退，不会再重建一遍。
-		//
-		// 两次检查都是纯只读的（shouldRefreshOutputs / 存在性与脏标志），不含共享缓存写入，
-		// 因此放在锁外安全；产物本身的写入仍由锁内的 provideMappedProviders 完成。
 		cacheService.runExclusiveChecking(lockRoot, key, LoomCacheService.defaultTimeout(),
-				() -> isMappedJarsWarm(extension, project, jarConfiguration, intermediaryMinecraftProvider,
+				() -> areMappedProvidersReadyForConfiguration(extension, project, jarConfiguration, intermediaryMinecraftProvider,
 						namedMinecraftProvider, warmContext),
 				() -> {
 					// 已就绪（无需生产）：照旧读已发布的产物。这一步不含共享缓存写入。
@@ -369,30 +356,30 @@ public abstract class CompileConfiguration implements Runnable {
 	}
 
 	/**
-	 * {@return 所有 mapped provider 的产物是否已就绪（无需重建）}.
+	 * {@return 所有 mapped provider 是否均无需在配置期写共享产物}.
 	 *
-	 * <p>shouldRefreshOutputs 仅做文件存在性与脏标志检查，不写入任何共享缓存，可安全在锁外调用。
+	 * <p>优先按任务投影的纯模型条件判断；只有配置期回退形态才检查实际产物状态。
 	 */
-	private boolean isMappedJarsWarm(LoomGradleExtension extension, Project project, MinecraftJarConfiguration<?, ?, ?> jarConfiguration,
+	private boolean areMappedProvidersReadyForConfiguration(LoomGradleExtension extension, Project project, MinecraftJarConfiguration<?, ?, ?> jarConfiguration,
 			IntermediaryMinecraftProvider<?> intermediaryMinecraftProvider,
 			NamedMinecraftProvider<?> namedMinecraftProvider,
 			AbstractMappedMinecraftProvider.ProvideContext context) {
-		if (intermediaryMinecraftProvider != null && !intermediaryMinecraftProvider.isUpToDate(context)) {
+		if (intermediaryMinecraftProvider != null && !intermediaryMinecraftProvider.isReadyForConfiguration(context)) {
 			return false;
 		}
 
-		if (!namedMinecraftProvider.isUpToDate(context)) {
+		if (!namedMinecraftProvider.isReadyForConfiguration(context)) {
 			return false;
 		}
 
 		if (extension.isForge()) {
-			if (!jarConfiguration.createSrgMinecraftProvider(project).isUpToDate(context)) {
+			if (!jarConfiguration.createSrgMinecraftProvider(project).isReadyForConfiguration(context)) {
 				return false;
 			}
 		}
 
 		if (extension.isForgeLike() && extension.getForgeProvider().usesMojangAtRuntime() && !extension.isUnobfuscatedForge()) {
-			if (!jarConfiguration.createMojangMappedMinecraftProvider(project).isUpToDate(context)) {
+			if (!jarConfiguration.createMojangMappedMinecraftProvider(project).isReadyForConfiguration(context)) {
 				return false;
 			}
 		}
diff --git a/src/main/java/net/fabricmc/loom/configuration/providers/mappings/MappingConfiguration.java b/src/main/java/net/fabricmc/loom/configuration/providers/mappings/MappingConfiguration.java
index 11ad057f9a183a4b428a0d29a9ac3e206c2f2aa6..89e94153f4a4ba9893136b2013034adbc956d976 100644
--- a/src/main/java/net/fabricmc/loom/configuration/providers/mappings/MappingConfiguration.java
+++ b/src/main/java/net/fabricmc/loom/configuration/providers/mappings/MappingConfiguration.java
@@ -311,13 +311,14 @@ public class MappingConfiguration {
 	 *
 	 * <p>放宽的只有**迁移产物**这一族；其余选项（原始 mappings、mixin 派生映射）仍按存在性拒绝，
 	 * 因为那些文件在配置期结束时必定已由本类的 setup/setupPost 落位，缺失说明配置流程本身出了问题。
+	 * 必须先判断是否为任务产物再检查文件，否则首轮任务生成文件本身就会使下一轮配置缓存失效。
 	 */
 	public Path getMappingsPath(MappingOption mappingOption) {
 		Supplier<Path> mappingsSupplier = this.mappingOptions.get(mappingOption);
 
 		if (mappingsSupplier == null) {
 			throw new UnsupportedOperationException("Unsupported mapping option: " + mappingOption + ", it is possible that this option is not supported by this project / platform!");
-		} else if (Files.notExists(mappingsSupplier.get()) && !isTaskProducedMappings(mappingOption)) {
+		} else if (!isTaskProducedMappings(mappingOption) && Files.notExists(mappingsSupplier.get())) {
 			throw new UnsupportedOperationException("Mapping option " + mappingOption + " found but file does not exist!");
 		}
 
diff --git a/src/main/java/net/fabricmc/loom/configuration/providers/minecraft/mapped/AbstractMappedMinecraftProvider.java b/src/main/java/net/fabricmc/loom/configuration/providers/minecraft/mapped/AbstractMappedMinecraftProvider.java
index 5ae0f64114779f9d5a64aa093e9ebbff4a0f4e28..523cbe7a3d7ed30fade5271098ecc174d963e474 100644
--- a/src/main/java/net/fabricmc/loom/configuration/providers/minecraft/mapped/AbstractMappedMinecraftProvider.java
+++ b/src/main/java/net/fabricmc/loom/configuration/providers/minecraft/mapped/AbstractMappedMinecraftProvider.java
@@ -425,11 +425,42 @@ public abstract class AbstractMappedMinecraftProvider<M extends MinecraftProvide
 	}
 
 	/**
-	 * {@return 产物是否已就绪（无需重建）}.
+	 * {@return 本轮能否只在配置期接线，而不生产共享产物}.
 	 *
-	 * <p>供外部（如 {@code minecraft-provision} 事务锁的无锁快路径）在锁外做只读判定；
-	 * 实现即 {@link #shouldRefreshOutputs} 的取反，判定产物存在且内容可复用（见下）。
+	 * <p>可任务化时不观察 jar、POM 或 backup 是否已存在：它们的有效性由执行期任务保证。
+	 * 必须在配置期生产的形态仍按实际产物就绪状态进入原有事务锁，不能放松回退的互斥协议。
 	 */
+	public boolean isReadyForConfiguration(ProvideContext context) {
+		if (taskProduction && usesProvisioningImplementation(AbstractMappedMinecraftProvider.class)) {
+			try {
+				for (RemappedJars remappedJar : getRemappedJars()) {
+					verifyProjectable(remappedJar);
+				}
+
+				return true;
+			} catch (UnsupportedOperationException e) {
+				// 实际 provide 会说明回退原因；这里只保留配置期生产的就绪检查。
+			}
+		}
+
+		return isUpToDate(context);
+	}
+
+	/**
+	 * {@return provide 是否仍由已审核的实现承担}.
+	 *
+	 * <p>只检查方法的声明者，不调用钩子。第三方覆写 provide 后可能在配置期写盘，
+	 * 不能仅凭基类的任务开关就绕过原有事务锁；需由其显式覆写 readiness 说明契约。
+	 */
+	protected final boolean usesProvisioningImplementation(Class<?> implementation) {
+		try {
+			return getClass().getMethod("provide", ProvideContext.class).getDeclaringClass() == implementation;
+		} catch (NoSuchMethodException e) {
+			throw new IllegalStateException("Minecraft provider 缺少 provide 方法", e);
+		}
+	}
+
+	/** {@return 产物是否已就绪，无需配置期重建} 仅用于配置期回退形态的就绪判定. */
 	public boolean isUpToDate(ProvideContext context) {
 		return !shouldRefreshOutputs(context);
 	}
