上一个补丁让一个 mod 声明多个 class tweaker 时不再抛异常，但只有单元测试覆盖
（造 jar 直接调 API），没走真实的 remapMods 链路。仓库里也一直没有 schema v2
多声明的夹具——这条路径恰恰是唯一会让用户构建直接崩的。

新增夹具 projects/multiClassTweaker：一个 dummy mod，fabric.mod.json 声明两个
classTweaker（client.accesswidener 只在 client 生效，universal.accesswidener），
被消费方工程以 modImplementation files() 依赖；用例跑真实 build。

判据是"构建成功"：改造前读到第二个声明就会抛
UnsupportedOperationException("TODO: support multiple class tweakers")。
内容级正确性（两条各自重映射成 named、逐个写回不互相覆盖）由
AccessWidenerUtilsTest 的单元测试覆盖。

Origin: vendor, wcpe-loom
Forwarded: not-needed
Patch-Name: class-tweakers-e2e

diff --git a/src/test/groovy/net/fabricmc/loom/test/integration/AccessWidenerTest.groovy b/src/test/groovy/net/fabricmc/loom/test/integration/AccessWidenerTest.groovy
index de245e64ab1fe37a504ba972584a1a59c89b6477..68c969a2ba0459fec0e565d83b41b19e1c0937e2 100644
--- a/src/test/groovy/net/fabricmc/loom/test/integration/AccessWidenerTest.groovy
+++ b/src/test/groovy/net/fabricmc/loom/test/integration/AccessWidenerTest.groovy
@@ -100,6 +100,27 @@ class AccessWidenerTest extends Specification implements GradleProjectTestTrait
 		version << STANDARD_TEST_VERSIONS
 	}
 
+	@Unroll
+	def "multiple class tweakers in a dependency (gradle #version)"() {
+		setup: '一个 mod 带两个 class tweaker：一个只在 client 生效，一个 universal'
+		def gradle = gradleProject(project: "multiClassTweaker", version: version)
+		ZipUtils.pack(new File(gradle.projectDir, "dummyDependency").toPath(), new File(gradle.projectDir, "dummy.jar").toPath())
+
+		when:
+		def result = gradle.run(task: "build")
+
+		then: '改造前这里会在 AccessWidenerUtils 抛 UnsupportedOperationException("TODO: support multiple class tweakers")，走不到 SUCCESS'
+		result.task(":build").outcome == SUCCESS
+
+		// 内容级正确性（两个声明各自重映射成 named、逐个写回不互相覆盖）由单元测试
+		// AccessWidenerUtilsTest 覆盖（它造 jar 直接验字节）。
+		// 本用例只需证明：真实的 remapMods 链路在多声明下能跑完 —— 旧的单声明路径
+		// 在读到第二个声明时就会抛异常，因此“构建成功”本身就是回归判据。
+
+		where:
+		version << STANDARD_TEST_VERSIONS
+	}
+
 	@Unroll
 	def "invalid (#awLine)"() {
 		setup:
diff --git a/src/test/resources/projects/multiClassTweaker/build.gradle b/src/test/resources/projects/multiClassTweaker/build.gradle
new file mode 100644
index 0000000000000000000000000000000000000000..5e2e55e5a97f547a8a75e15f2280e6c310455abd
--- /dev/null
+++ b/src/test/resources/projects/multiClassTweaker/build.gradle
@@ -0,0 +1,21 @@
+// 本夹具用于验证：一个 mod 声明**多个** class tweaker 时，依赖它的工程仍能构建。
+// 改造前 AccessWidenerUtils 会抛 UnsupportedOperationException("TODO: support multiple class tweakers")。
+plugins {
+	id 'dev.architectury.loom'
+}
+
+version = "1.0.0"
+group = "com.example"
+
+dependencies {
+	minecraft "com.mojang:minecraft:1.17.1"
+	mappings "net.fabricmc:yarn:1.17.1+build.59:v2"
+	modImplementation "net.fabricmc:fabric-loader:0.11.6"
+
+	// dummy.jar 由测试在 setup 里用 ZipUtils.pack 从 dummyDependency/ 打包
+	modImplementation files("dummy.jar")
+}
+
+base {
+	archivesName = "multi-class-tweaker-mod"
+}
diff --git a/src/test/resources/projects/multiClassTweaker/dummyDependency/client.accesswidener b/src/test/resources/projects/multiClassTweaker/dummyDependency/client.accesswidener
new file mode 100644
index 0000000000000000000000000000000000000000..c265327b4c021ea8980e6db5b0ba1bbc4527ce10
--- /dev/null
+++ b/src/test/resources/projects/multiClassTweaker/dummyDependency/client.accesswidener
@@ -0,0 +1,3 @@
+accessWidener	v2	intermediary
+
+accessible	class	net/minecraft/class_1928$class_5199
diff --git a/src/test/resources/projects/multiClassTweaker/dummyDependency/fabric.mod.json b/src/test/resources/projects/multiClassTweaker/dummyDependency/fabric.mod.json
new file mode 100644
index 0000000000000000000000000000000000000000..745fce9e82c7ec268a0ee9c0e9739bcbde48a481
--- /dev/null
+++ b/src/test/resources/projects/multiClassTweaker/dummyDependency/fabric.mod.json
@@ -0,0 +1,10 @@
+{
+  "schemaVersion": 2,
+  "id": "dummy",
+  "version": "1",
+  "name": "Dummy Mod With Two Class Tweakers",
+  "classTweakers": [
+    { "config": "client.accesswidener", "environment": "client" },
+    "universal.accesswidener"
+  ]
+}
diff --git a/src/test/resources/projects/multiClassTweaker/dummyDependency/universal.accesswidener b/src/test/resources/projects/multiClassTweaker/dummyDependency/universal.accesswidener
new file mode 100644
index 0000000000000000000000000000000000000000..8d7310628067c6e6b429568eed9d203c14365368
--- /dev/null
+++ b/src/test/resources/projects/multiClassTweaker/dummyDependency/universal.accesswidener
@@ -0,0 +1,3 @@
+accessWidener	v2	intermediary
+
+transitive-accessible	method	net/minecraft/class_1972	method_8775	(Ljava/lang/String;)Lnet/minecraft/class_5321;
diff --git a/src/test/resources/projects/multiClassTweaker/src/main/java/ExampleMod.java b/src/test/resources/projects/multiClassTweaker/src/main/java/ExampleMod.java
new file mode 100644
index 0000000000000000000000000000000000000000..714905023f41933611e7fee925e503f468090774
--- /dev/null
+++ b/src/test/resources/projects/multiClassTweaker/src/main/java/ExampleMod.java
@@ -0,0 +1,15 @@
+import net.minecraft.util.registry.RegistryKey;
+import net.minecraft.world.biome.Biome;
+import net.minecraft.world.biome.BiomeKeys;
+
+import net.fabricmc.api.ModInitializer;
+
+public class ExampleMod implements ModInitializer {
+	@Override
+	public void onInitialize() {
+		// 这个成员由依赖 mod 的 universal.accesswidener 开放。
+		// 两个声明只要漏掉任何一个，本工程都构建不过（旧的单声明路径会直接抛异常）。
+		RegistryKey<Biome> key = BiomeKeys.register("dummy");
+		System.out.println(key);
+	}
+}
