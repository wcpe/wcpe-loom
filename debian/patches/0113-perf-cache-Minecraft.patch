+		downloadFuture.get(boundSeconds * 2, TimeUnit.SECONDS)
+		mergeFuture.get(boundSeconds * 2, TimeUnit.SECONDS)
+
+		then: "两个临界区确实重叠过（各自看到了对方在内）"
+		downloadSawMerge.get()
+		mergeSawDownload.get()
+
+		cleanup:
