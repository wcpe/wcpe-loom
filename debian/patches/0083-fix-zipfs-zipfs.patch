+		TinyRemapperService service = factory.get(options)
+
+		then: "诊断明确指出是哪条路径被毒化、以及自愈已尝试过"
+		def e = thrown(RuntimeException)
+		e.message.contains("JDK-8291712")
+		e.message.contains(jar.toString())
+		e.message.contains("自愈")
+
+		cleanup:
