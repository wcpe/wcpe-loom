 	private static final Map<String, MappingConfiguration> SHARED_INSTANCES = new ConcurrentHashMap<>();
 
 	/**
-	 * 早缓存索引：键仅由「声明信息」构成（不触发依赖解析），用于在解析 MAPPINGS 之前就命中已产出的实例。
