diff --git a/src/main/java/net/fabricmc/loom/configuration/mods/ArtifactMetadata.java b/src/main/java/net/fabricmc/loom/configuration/mods/ArtifactMetadata.java
index 694b3388c5d199db6a0f7cdef617560c851e3fad..09b1744080e00de6d8ef325f1f9d4edd5299d095 100644
--- a/src/main/java/net/fabricmc/loom/configuration/mods/ArtifactMetadata.java
+++ b/src/main/java/net/fabricmc/loom/configuration/mods/ArtifactMetadata.java
@@ -154,13 +154,10 @@ public record ArtifactMetadata(boolean isFabricMod, RemapRequirements remapRequi
 			return;
 		}
 
-		final String[] versionParts = version.split("\\.");
-		final String[] currentVersionParts = currentLoomVersion.split("\\.");
-
 		// Check major and minor version
 		for (int i = 0; i < 2; i++) {
-			final int versionPart = Integer.parseInt(versionParts[i]);
-			final int currentVersionPart = Integer.parseInt(currentVersionParts[i]);
+			final int versionPart = parseVersionPart(version, i);
+			final int currentVersionPart = parseVersionPart(currentLoomVersion, i);
 
 			if (versionPart > currentVersionPart) {
 				if (lenient) {
@@ -176,6 +173,17 @@ public record ArtifactMetadata(boolean isFabricMod, RemapRequirements remapRequi
 		}
 	}
 
+	private static int parseVersionPart(String version, int part) {
+		final String normalizedVersion = version.replaceFirst("-wcpe-(?:0|[1-9]\\d*|dev|ci)$", "");
+		final String[] versionParts = normalizedVersion.split("\\.");
+
+		if (versionParts.length <= part || !versionParts[part].matches("\\d+")) {
+			throw new IllegalStateException("Invalid Loom version: " + version);
+		}
+
+		return Integer.parseInt(versionParts[part]);
+	}
+
 	public boolean shouldRemap() {
 		return remapRequirements().getShouldRemap().test(this);
 	}
