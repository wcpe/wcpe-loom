+	}
+
 	@Override
 	public @Nullable String mappingId() {
-		return transitiveOnly ? mod.getId() : null;
+		return transitiveOnly ? modId : null;
 	}
 
 	@Override
 	public String getSortKey() {
-		return mod.getId() + ":" + path;
+		return modId + ":" + path;
 	}
 
 	@Override
@@ -73,7 +172,6 @@ public record ModAccessWidenerEntry(FabricModJson mod, String path, ModEnvironme
