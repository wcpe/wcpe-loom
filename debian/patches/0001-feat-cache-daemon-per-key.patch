index 0000000000000000000000000000000000000000..a238c86a8be21ff43994646cad7087fb3671b8f7
--- /dev/null
+++ b/src/main/java/net/fabricmc/loom/util/cache/AtomicFiles.java
@@ -0,0 +1,114 @@
