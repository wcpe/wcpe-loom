index 0000000000000000000000000000000000000000..c78b6559d04171a5be7932cd8acee8e9d03558e5
--- /dev/null
+++ b/src/main/java/net/fabricmc/loom/util/cache/CacheEntryLock.java
@@ -0,0 +1,171 @@
+/*
