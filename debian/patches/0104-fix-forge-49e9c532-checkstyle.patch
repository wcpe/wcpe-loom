49e9c532 把三个 showVerbose* 字段从 @Input 改成 @Internal 时新增的 Javadoc 存在两类问题，
被 CI 的 :checkstyleMain 拦下（run 40638565347 的 build 作业即因此失败，整个测试矩阵与
发布随之跳过）：

- 三处 Javadoc 首句以「。」结尾，而本仓库 checkstyle 要求以「.」结尾；
- ForgeSourcesService 里 org.gradle.api.tasks.Input 改成 @Internal 后不再被引用，
  成了 unused import。

只改注释标点与删除未使用 import，不改任何行为与缓存键。

Origin: vendor, wcpe-loom
Forwarded: no

diff --git a/src/main/java/dev/architectury/loom/forge/ForgeSourcesService.java b/src/main/java/dev/architectury/loom/forge/ForgeSourcesService.java
index 27947443b1e4dd24eaed7d0e8d663806cd8fd5c4..b36c627f658033da668d1c1df8359e93a9a0032b 100644
--- a/src/main/java/dev/architectury/loom/forge/ForgeSourcesService.java
+++ b/src/main/java/dev/architectury/loom/forge/ForgeSourcesService.java
@@ -30,7 +30,6 @@ import org.gradle.api.logging.Logger;
 import org.gradle.api.logging.Logging;
 import org.gradle.api.provider.Property;
 import org.gradle.api.provider.Provider;
-import org.gradle.api.tasks.Input;
 import org.gradle.api.tasks.InputFiles;
 import org.gradle.api.tasks.Internal;
 import org.gradle.api.tasks.Nested;
@@ -102,7 +101,7 @@ public final class ForgeSourcesService extends Service<ForgeSourcesService.Optio
 		Property<SourceRemapperService.Options> getSourceRemapperService();
 
 		/**
-		 * 是否把工具的标准错误透传到构建日志。
+		 * 是否把工具的标准错误透传到构建日志.
 		 *
 		 * <p>标记为 {@code @Internal} 而**不是** {@code @Input}：它只决定错误流接哪里，
 		 * 不参与任何产物字节；而取值随构建日志级别与 stacktrace 开关变化
diff --git a/src/main/java/dev/architectury/loom/forge/tool/ForgeToolExecutor.java b/src/main/java/dev/architectury/loom/forge/tool/ForgeToolExecutor.java
index 0615bdaa609e58bebb6967589578a47711489ec2..7d89714ec2e5d3732c0435ac8380ede99a4d177f 100644
--- a/src/main/java/dev/architectury/loom/forge/tool/ForgeToolExecutor.java
+++ b/src/main/java/dev/architectury/loom/forge/tool/ForgeToolExecutor.java
@@ -113,7 +113,7 @@ public final class ForgeToolExecutor {
 		ConfigurableFileCollection getExecClasspath();
 
 		/**
-		 * 是否把工具的标准输出透传到构建日志。
+		 * 是否把工具的标准输出透传到构建日志.
 		 *
 		 * <p>标记为 {@code @Internal} 而**不是** {@code @Input}：本值只决定「输出流接哪里」，
 		 * 不参与任何产物字节。而它的取值随构建日志级别变化（{@link #shouldShowVerboseStdout}），
@@ -128,7 +128,7 @@ public final class ForgeToolExecutor {
 		@Internal
 		Property<Boolean> getShowVerboseStdout();
 
-		/** 同 {@link #getShowVerboseStdout()}：只影响日志透传，不影响产物。 */
+		/** 同 {@link #getShowVerboseStdout()}：只影响日志透传，不影响产物. */
 		@Internal
 		Property<Boolean> getShowVerboseStderr();
 
