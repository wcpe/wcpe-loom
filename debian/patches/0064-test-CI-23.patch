+		aw.text = ACCESS_WIDENER
+		new File(gradle.projectDir, "src/main/resources/perturb.accesswidener").text = PERTURBED_ACCESS_WIDENER
+
+		def source = new File(gradle.projectDir, "src/main/java/com/example/Example.java")
