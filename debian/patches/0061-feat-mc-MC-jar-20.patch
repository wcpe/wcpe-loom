+			for (Method method : type.getDeclaredMethods()) {
+				if (method.getName().equals("configureRemapper")
+						&& method.getParameterCount() == 2
+						&& method.getParameterTypes()[0] == RemappedJars.class) {
+					return true;
+				}
+			}
+		}
+
+		return false;
+	}
