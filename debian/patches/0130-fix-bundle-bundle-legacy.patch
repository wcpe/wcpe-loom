+	// 同时供可用性判定和实际读取使用，避免两条入口对损坏缓存作出不同结论。
+	static Optional<CachedMetadata> loadCached(SpecStore store, @Nullable String artifactSha1) {
 		if (artifactSha1 == null) {
-			return false;
+			return Optional.empty();
 		}
 
