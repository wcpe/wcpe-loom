@@ -1335,9 +1335,10 @@ public class MappingConfiguration {
 	 */
 	private void writeReplacedTarget(LoomGradleExtension loom, String namespace, Path path) throws Exception {
 		// 此处拿不到 Project（无法用 LoomCacheService 的 JVM 内监视器），直接用同一 key 的跨进程锁。
-		// 该锁不可重入：同一 JVM 内已有线程持有同一 key 时，CacheEntryLock.acquireFileLockWithTimeout
-		// 只在 OverlappingFileLockException 之后空等轮询，直到 LoomCacheService.defaultTimeout() 超时。
-		// 因此调用点必须保证不会在已持有该 key 的锁内再次进入（尤其是与 produceMappings 的重入）；
+		// 该锁同线程可重入（CacheEntryLock 维护线程内重入计数），因此即使调用点已在同一 key
+		// 的锁内（例如与 produceMappings / runWithMappingsLock 的重入）也不会再等自己。
+		// 但跨线程仍然互斥：其它线程持同一 key 时会一直等到 LoomCacheService.defaultTimeout()，
+		// 所以不要因为「可重入」就把这把锁当作可跨线程嵌套使用的递归锁。
 		// 本方法自身不调用任何需要同一把锁的代码。
 		final Path lockRoot = loom.getFiles().getCacheLocks().toPath();
 
diff --git a/src/main/java/net/fabricmc/loom/util/cache/CacheEntryLock.java b/src/main/java/net/fabricmc/loom/util/cache/CacheEntryLock.java
index c78b6559d04171a5be7932cd8acee8e9d03558e5..34a933278a8da30c8b8794d9bad6d5ccb2c210d0 100644
--- a/src/main/java/net/fabricmc/loom/util/cache/CacheEntryLock.java
+++ b/src/main/java/net/fabricmc/loom/util/cache/CacheEntryLock.java
@@ -34,6 +34,8 @@ import java.nio.file.Path;
 import java.nio.file.StandardOpenOption;
 import java.time.Duration;
 import java.time.LocalTime;
+import java.util.HashMap;
+import java.util.Map;
 import java.util.concurrent.Callable;
 
 import org.gradle.api.GradleException;
@@ -49,6 +51,11 @@ import net.fabricmc.loom.util.Checksum;
  * 通过该锁串行化，避免重复或损坏的写入。读已发布缓存的路径不应使用此工具（读路径无锁）。
  */
 public final class CacheEntryLock {
+	// 本线程已持有的锁文件（绝对路径）→ 重入层数。只在当前线程内可见，因此不会削弱任何互斥：
+	// 跨线程仍靠 NIO 文件锁（OverlappingFileLockException 分支继续轮询），跨进程仍靠文件锁本身。
+	// 用锁文件路径而不是 key 作身份：不同 lockRoot 下同名 key 指向不同锁文件，本就不该算重入。
+	private static final ThreadLocal<Map<String, Integer>> HELD_LOCKS = ThreadLocal.withInitial(HashMap::new);
+
 	private CacheEntryLock() {
 	}
 
@@ -59,6 +66,9 @@ public final class CacheEntryLock {
 	 * 供其它等待进程读取并播报「锁被谁持有」；释放锁时删除旁文件。持有者信息不写入锁文件本体，
 	 * 因为 Windows 的文件锁是强制锁，其它进程读被锁文件会被拒绝。
 	 *
+	 * <p><b>可重入性</b>：同一线程已持有同一锁文件时，内层调用<b>不再抢锁</b>，直接执行
+	 * {@code action}，退出时只递减重入计数。仅同线程同锁文件可重入；跨线程、跨进程仍完全互斥。
+	 *
 	 * @param lockRoot 锁文件所在目录，会按需创建
 	 * @param key      缓存条目的逻辑 key，内部以其 sha256 命名锁文件
 	 * @param timeout  等待锁的最长时间，超时抛出 {@link GradleException}
@@ -68,18 +78,47 @@ public final class CacheEntryLock {
 	 * @throws Exception action 自身抛出的异常会原样向上传播
 	 */
 	public static <T> T withLock(Path lockRoot, String key, Duration timeout, Callable<T> action) throws Exception {
-		Files.createDirectories(lockRoot);
 		// 锁文件长期复用，不在结束时删除，避免「删文件」与「持锁」之间的竞态
 		final Path lockFile = lockRoot.resolve(Checksum.of(key).sha256().hex() + ".lock");
 		final Path ownerFile = lockFile.resolveSibling(lockFile.getFileName() + ".owner");
+		// 以绝对规范化路径作为重入身份，避开 "a/../b" 与相对路径对不上同一文件的问题
+		final String lockId = lockFile.toAbsolutePath().normalize().toString();
+		final Map<String, Integer> held = HELD_LOCKS.get();
+
+		if (held.containsKey(lockId)) {
+			// 重入：外层已持有该文件锁，内层不得再碰 channel/lock，只把层数 +1
+			held.put(lockId, held.get(lockId) + 1);
+
+			try {
+				return action.call();
+			} finally {
+				// 递归只减计数，绝不删旁文件、绝不 release（那些归最外层）
+				decrement(held, lockId);
+			}
+		}
+
+		// createDirectories 放在重入判定之后：内层路径完全不做 IO，与「取得锁后直接执行」的语义一致
+		Files.createDirectories(lockRoot);
 
 		try (FileChannel channel = FileChannel.open(lockFile, StandardOpenOption.CREATE, StandardOpenOption.WRITE, StandardOpenOption.READ)) {
 			FileLock lock = acquireFileLockWithTimeout(channel, key, ownerFile, timeout);
 			writeOwnerInfo(ownerFile, key);
+			// 必须在拿到文件锁之后才记账：抢锁失败/超时抛异常时不会留下脏计数，也就不会被误判成重入
+			held.put(lockId, 1);
 
 			try {
 				return action.call();
 			} finally {
+				// 先清本线程的持有记录，再删旁文件、最后 release。可重入性只靠本线程的计数，
+				// 而本线程此刻尚在 finally 里，不可能并发地重入同一个 key，所以这个顺序是安全的。
+				held.remove(lockId);
+
+				// 本线程已不持任何锁时把整个 map 从 ThreadLocal 摘掉，
+				// 避免长命线程（Gradle daemon 的 worker 线程）永久挂着一个空 map
+				if (held.isEmpty()) {
+					HELD_LOCKS.remove();
+				}
+
 				// 先删持有者旁文件再释放锁：等待者只在拿不到锁时才读旁文件，
 				// 此顺序保证旁文件存在时其内容必出自当前（或刚释放的）持有者，不会长期误导
 				try {
@@ -95,6 +134,20 @@ public final class CacheEntryLock {
 		}
 	}
 
+	// 重入计数递减一层；归零时直接移除条目.
+	//
+	// 不用 merge(key, -1, Integer::sum)：那样归零后条目会以值 0 留下，而且一旦被减成负数，
+	// 条目就永远清不掉，后续调用会把它误判为「已持有」而不取锁。
+	private static void decrement(Map<String, Integer> held, String lockId) {
+		final Integer depth = held.get(lockId);
+
+		if (depth == null || depth <= 1) {
+			held.remove(lockId);
+		} else {
+			held.put(lockId, depth - 1);
+		}
+	}
+
 	// 带超时的 NIO 文件锁获取：通过轮询 tryLock() 实现超时等待
 	@SuppressWarnings("BusyWait")
 	private static FileLock acquireFileLockWithTimeout(FileChannel channel, String key, Path ownerFile, Duration timeout) throws IOException {
diff --git a/src/test/groovy/net/fabricmc/loom/test/unit/cache/CacheEntryLockTest.groovy b/src/test/groovy/net/fabricmc/loom/test/unit/cache/CacheEntryLockTest.groovy
index 4b824d6135cf1c46d1a8ab380e5d9fb95639bb00..9386eaed51f6bc58cb2a5a013056a5fa5feb6512 100644
--- a/src/test/groovy/net/fabricmc/loom/test/unit/cache/CacheEntryLockTest.groovy
+++ b/src/test/groovy/net/fabricmc/loom/test/unit/cache/CacheEntryLockTest.groovy
@@ -31,7 +31,9 @@ import java.util.concurrent.Executors
 import java.util.concurrent.TimeUnit
 import java.util.concurrent.atomic.AtomicBoolean
 import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicReference
 
+import org.gradle.api.GradleException
 import spock.lang.Specification
 import spock.lang.TempDir
 
@@ -88,4 +90,151 @@ class CacheEntryLockTest extends Specification {
 		counter.get() == threads
 		conflicts.get() == 0
 	}
+
+	def "同一线程嵌套获取同一 key 立即返回（外层超时 1 秒，不可重入就会超时失败）"() {
+		given: "三层都用 1 秒超时——这本身就是断言：不可重入时最内层会一直轮询到超时抛 GradleException"
+		Duration shortTimeout = Duration.ofSeconds(1)
+		AtomicInteger deepestCalls = new AtomicInteger(0)
+
+		when:
+		def result = CacheEntryLock.withLock(lockRoot, "nested-key", shortTimeout) {
+			CacheEntryLock.withLock(lockRoot, "nested-key", shortTimeout) {
+				CacheEntryLock.withLock(lockRoot, "nested-key", shortTimeout) {
+					deepestCalls.incrementAndGet()
+					return "深度 3 的返回值"
+				}
+			}
+		}
+
+		then: "返回值从最内层透传出来，且确实只执行了一次"
+		result == "深度 3 的返回值"
+		deepestCalls.get() == 1
+
+		when: "嵌套退出后计数应归零、文件锁应已释放：另一个线程能以极短超时立刻拿到这把锁"
+		AtomicReference<Throwable> otherThreadFailure = new AtomicReference<>()
+		def pool = Executors.newSingleThreadExecutor()
+		def other = pool.submit {
+			try {
+				CacheEntryLock.withLock(lockRoot, "nested-key", Duration.ofSeconds(1)) { -> null }
+			} catch (Throwable t) {
+				otherThreadFailure.set(t)
+			}
+		}
+		other.get(30, TimeUnit.SECONDS)
+		pool.shutdown()
+
+		then:
+		otherThreadFailure.get() == null
+	}
+
+	def "嵌套内层抛异常不泄露重入计数：同线程下次获取仍会真去抢文件锁"() {
+		given:
+		Duration shortTimeout = Duration.ofSeconds(1)
+		RuntimeException boom = new RuntimeException("boom")
+		Throwable thrown = null
+
+		when: "同线程嵌套一次，内层抛异常"
+		try {
+			CacheEntryLock.withLock(lockRoot, "boom-key", shortTimeout) {
+				CacheEntryLock.withLock(lockRoot, "boom-key", shortTimeout) {
+					throw boom
+				}
+			}
+		} catch (Exception e) {
+			thrown = e
+		}
+
+		then: "异常原样上抛（两层 finally 都跑过了）"
+		thrown.is(boom)
+
+		when: "另一线程正持着同一把锁时，本线程再次获取"
+		CountDownLatch heldByOther = new CountDownLatch(1)
+		CountDownLatch releaseOther = new CountDownLatch(1)
+		AtomicReference<Throwable> holderFailure = new AtomicReference<>()
+		def pool = Executors.newSingleThreadExecutor()
+		def holder = pool.submit {
+			try {
+				CacheEntryLock.withLock(lockRoot, "boom-key", Duration.ofSeconds(10)) {
+					heldByOther.countDown()
+					releaseOther.await()
+					return null
+				}
+			} catch (Throwable t) {
+				holderFailure.set(t)
+			}
+		}
+		boolean acquired = heldByOther.await(10, TimeUnit.SECONDS)
+
+		Throwable secondThrow = null
+
+		if (acquired) {
+			try {
+				CacheEntryLock.withLock(lockRoot, "boom-key", shortTimeout) { -> null }
+			} catch (Exception e) {
+				secondThrow = e
+			}
+		}
+
+		then: "若重入计数泄露成本线程「已持有」，这里会直接返回而不取锁；没泄露则等到超时"
+		acquired
+		secondThrow instanceof GradleException
+
+		cleanup:
+		releaseOther.countDown()
+		holder?.get(30, TimeUnit.SECONDS)
+		pool.shutdownNow()
+		assert holderFailure.get() == null
+	}
+
+	def "不同线程拿同一 key 仍互斥：后到的线程等到超时并抛 GradleException"() {
+		given:
+		CountDownLatch heldByFirst = new CountDownLatch(1)
+		CountDownLatch releaseFirst = new CountDownLatch(1)
+		AtomicReference<Throwable> firstFailure = new AtomicReference<>()
+		AtomicInteger insideCriticalSection = new AtomicInteger(0)
+		AtomicReference<Throwable> waiterFailure = new AtomicReference<>()
+		def pool = Executors.newFixedThreadPool(2)
+
+		when: "线程 A 拿住锁不放"
+		def first = pool.submit {
+			try {
+				CacheEntryLock.withLock(lockRoot, "mutex-key", Duration.ofSeconds(30)) {
+					insideCriticalSection.incrementAndGet()
+					heldByFirst.countDown()
+					releaseFirst.await()
+					insideCriticalSection.decrementAndGet()
+					return null
+				}
+			} catch (Throwable t) {
+				firstFailure.set(t)
+			}
+		}
+		boolean firstHolding = heldByFirst.await(10, TimeUnit.SECONDS)
+
+		and: "线程 B 用 1 秒超时去拿同一 key，只记结果不阻塞"
+		if (firstHolding) {
+			def waiter = pool.submit {
+				try {
+					CacheEntryLock.withLock(lockRoot, "mutex-key", Duration.ofSeconds(1)) {
+						insideCriticalSection.incrementAndGet()
+						return null
+					}
+				} catch (Throwable t) {
+					waiterFailure.set(t)
+				}
+			}
+			waiter.get(30, TimeUnit.SECONDS)
+		}
+
+		then: "可重入只限同线程：线程 B 不得进入临界区，而是等到超时"
+		firstHolding
+		firstFailure.get() == null
+		waiterFailure.get() instanceof GradleException
+		insideCriticalSection.get() == 1
+
+		cleanup:
+		releaseFirst.countDown()
+		first?.get(30, TimeUnit.SECONDS)
+		pool.shutdownNow()
+	}
 }
