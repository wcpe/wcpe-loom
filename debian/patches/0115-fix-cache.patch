index 03eb3227057543968198abc4c5af983354c6640c..11ad057f9a183a4b428a0d29a9ac3e206c2f2aa6 100644
--- a/src/main/java/net/fabricmc/loom/configuration/providers/mappings/MappingConfiguration.java
